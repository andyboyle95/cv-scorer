# Anthropic API key — used for CV scoring and the Job Spec Creator.
ANTHROPIC_API_KEY=

# Optional site password gate (used by /login + /api/auth).
SITE_PASSWORD=
AUTH_SECRET=

# --- Job Spec Creator lead emails (Resend) ---------------------------------
# If RESEND_API_KEY and LEAD_FROM_EMAIL are unset, the form still works but
# lead emails are skipped (the lead is logged to the server console instead).
RESEND_API_KEY=
# Verified Resend sender, e.g. "Job Spec Creator <noreply@yourdomain.com>"
LEAD_FROM_EMAIL=
# Where new-lead notifications are sent (defaults to andyboyleaw@gmail.com).
LEAD_NOTIFICATION_EMAIL=

# OCR.space key for WC26 planner screenshot import (free 'helloworld' used if unset)
OCR_SPACE_API_KEY=
