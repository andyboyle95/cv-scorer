# Anthropic API key — used for CV scoring, tailoring, and every AI endpoint.
ANTHROPIC_API_KEY=

# --- Auth ------------------------------------------------------------------
# Postgres connection string. On Render, this is provided by the DB add-on.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# NextAuth secret — generate with `openssl rand -base64 32`. Required.
NEXTAUTH_SECRET=
# Public URL of the app. Required in production. Optional in dev (defaults to http://localhost:3000).
NEXTAUTH_URL=

# Bootstrap admin — this email is auto-promoted to ADMIN on any sign-in if no
# admin exists in the DB yet. Prevents lockout on a fresh deploy where the
# seed script hasn't run.
BOOTSTRAP_ADMIN_EMAIL=andyboyle95@gmail.com

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure Portal → App registrations → App)
# For personal + org (multi-tenant), leave AZURE_AD_TENANT_ID as "common".
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# --- Job Spec Creator lead emails (Resend) ---------------------------------
# Leads are ALWAYS stored in the database (Lead table) and listed under
# /admin -> Leads, so nothing is lost if email is misconfigured. These vars
# only control the notification emails on top of that.
#
# RESEND_API_KEY unset  -> no emails are sent at all (leads still captured).
RESEND_API_KEY=
# LEAD_FROM_EMAIL unset -> falls back to Resend's shared test sender
# (onboarding@resend.dev), which ONLY delivers to the address that owns the
# Resend account. Every other recipient is rejected with a 403 — this is the
# usual reason lead emails silently vanish. Verify a domain in Resend and set
# a sender on it, e.g. "Job Spec Creator <noreply@aaronwallis.co.uk>".
LEAD_FROM_EMAIL=
# Where new-lead notifications are sent. Comma-separated for several
# recipients. Defaults to info@aaronwallis.co.uk.
LEAD_NOTIFICATION_EMAIL=

# OCR.space key for WC26 planner screenshot import (free 'helloworld' used if unset)
OCR_SPACE_API_KEY=

# --- Sentry (error reporting) ------------------------------------------
# Leave both unset to disable Sentry entirely (SDK no-ops on empty DSN).
# See docs/sentry-setup.md for the 2-minute activation walkthrough.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Testing -----------------------------------------------------------
# Set to "1" ONLY in local test runs to bypass auth in middleware.
# Ignored in production (extra safety-check enforced in middleware itself).
TEST_AUTH_BYPASS=
