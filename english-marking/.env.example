# Postgres connection string (Render sets this from the database)
DATABASE_URL=postgres://user:pass@host:5432/redletter
# Set to "false" when using Render's internal database URL
DATABASE_SSL=false
# Shared staff password (MVP). Per-user Google/Microsoft sign-in is version 2.
ACCESS_PASSWORD=
# Random strings: signing session cookies, and hashing past-results candidate numbers
SESSION_SECRET=
ANON_SALT=
# Claude API key. Without it the app runs in demo mode with placeholder marks.
ANTHROPIC_API_KEY=
# URL subfolder the app lives under
BASE_PATH=/redletter
# Optional
# CLAUDE_MODEL=claude-opus-5-5
# WORKER_CONCURRENCY=3
