// Auth + admin schema for the Aaron Wallis recruitment tools.
//
// Two-role model (ADMIN / USER — MANAGER intentionally omitted; add later
// once a distinct permission set exists for it). Whitelist by individual
// email OR by domain. Database sessions so admin revocation kills any live
// session on the next request. Broad AuditEvent (not just LoginEvent) so
// admin actions are inspectable too.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- NextAuth standard tables --------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  revokedAt     DateTime?
  loginCount    Int       @default(0)
  lastLoginAt   DateTime?
  lastProvider  String?   // "google" | "azure-ad" — for the "Signed in with…" badge
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  cvDrafts CvDraft[]
}

// Usage analytics. One row per action a user takes across the whole tool
// suite (CV Generator, CV Scorer, Job Spec Creator, Interview Generator,
// Commute Calculator). Powers the /admin Usage tab so we can see what's
// being used and by whom, without shipping candidate PII to a 3rd party
// analytics platform. userId is nullable so the public /job-spec form
// (anonymous visitors) can also be tracked.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?  // denormalised for easier querying without joining
  tool      String   // "cv-generator" | "cv-scorer" | "job-spec-creator" | "interview-generator" | "commute-calculator"
  action    String   // "pdf-export" | "docx-export" | "anonymise" | "tailor" | "score" | ...
  meta      String?  // free-form JSON string for extras (e.g. spec attached: true, longer: true)
  createdAt DateTime @default(now())

  @@index([tool, action, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// CV drafts — durable per-user saved CVs powering the toolbar Recent
// dropdown. Client also keeps a localStorage copy for aggressive
// keystroke-level auto-save; this table is the cross-device source of
// truth and only writes on explicit save / on Download PDF / every 60s.
model CvDraft {
  id             String   @id @default(cuid())
  userId         String
  candidateName  String?
  roleAppliedFor String?
  data           Json     // full CandidateData blob
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  ext_expires_in    Int? // Microsoft/Azure AD returns this alongside expires_at
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Whitelist -----------------------------------------------------------

model AllowedUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      Role      @default(USER)
  addedBy   String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([revokedAt])
}

model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  role      Role     @default(USER)
  addedBy   String
  createdAt DateTime @default(now())
}

// ---- Audit ---------------------------------------------------------------

// Broad audit log covering sign-ins AND admin actions (user added/revoked,
// role changed, domain added/removed). The admin activity tab reads from
// this so you can answer "who granted this access?" not just "who logged in?".
model AuditEvent {
  id        String   @id @default(cuid())
  type      String   // e.g. SIGN_IN, USER_ADDED, USER_REVOKED, ROLE_CHANGED, DOMAIN_ADDED, DOMAIN_REMOVED, USER_RESTORED
  actor     String   // email of the person performing the action ("system" for auto events)
  target    String?  // email or domain the action concerns
  meta      String?  // free-form JSON string for extras (provider, oldRole, newRole, etc.)
  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ---- Enum ----------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

// Job Spec Creator leads. The /job-spec form is a public lead-gen tool
// embedded in an iframe on aaronwallis.co.uk — the whole point of it is that
// we get the enquirer's details. Email delivery is a best-effort side-channel
// (Resend can be misconfigured, rate-limited or down), so the row written here
// is the source of truth: a lead is captured the moment the spec is generated,
// whether or not the notification email ever leaves the building.
//
// notifyStatus / copyStatus track the two emails we attempt per submission so
// the /admin Leads tab can show delivery failures instead of hiding them.
//   "sent"    — Resend accepted it
//   "failed"  — Resend rejected it (reason in notifyError / copyError)
//   "skipped" — not attempted (no RESEND_API_KEY configured)
//   "pending" — row written, send not finished (process died mid-request)
model Lead {
  id           String   @id @default(cuid())
  source       String   @default("job-spec-creator")
  name         String
  email        String
  companyUrl   String?
  jobTitle     String?
  industry     String?
  jobFunction  String?
  seniority    String?
  answers      Json // full submitted form payload
  spec         Json? // the generated job + person spec
  notifyStatus String   @default("pending")
  notifyError  String?
  copyStatus   String   @default("pending")
  copyError    String?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([email])
}
