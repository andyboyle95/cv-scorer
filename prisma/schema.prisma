// Auth + admin schema for the Aaron Wallis recruitment tools.
//
// Two-role model (ADMIN / USER — MANAGER intentionally omitted; add later
// once a distinct permission set exists for it). Whitelist by individual
// email OR by domain. Database sessions so admin revocation kills any live
// session on the next request. Broad AuditEvent (not just LoginEvent) so
// admin actions are inspectable too.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- NextAuth standard tables --------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  revokedAt     DateTime?
  loginCount    Int       @default(0)
  lastLoginAt   DateTime?
  lastProvider  String?   // "google" | "azure-ad" — for the "Signed in with…" badge
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Whitelist -----------------------------------------------------------

model AllowedUser {
  id        String    @id @default(cuid())
  email     String    @unique
  role      Role      @default(USER)
  addedBy   String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([revokedAt])
}

model AllowedDomain {
  id        String   @id @default(cuid())
  domain    String   @unique
  role      Role     @default(USER)
  addedBy   String
  createdAt DateTime @default(now())
}

// ---- Audit ---------------------------------------------------------------

// Broad audit log covering sign-ins AND admin actions (user added/revoked,
// role changed, domain added/removed). The admin activity tab reads from
// this so you can answer "who granted this access?" not just "who logged in?".
model AuditEvent {
  id        String   @id @default(cuid())
  type      String   // e.g. SIGN_IN, USER_ADDED, USER_REVOKED, ROLE_CHANGED, DOMAIN_ADDED, DOMAIN_REMOVED, USER_RESTORED
  actor     String   // email of the person performing the action ("system" for auto events)
  target    String?  // email or domain the action concerns
  meta      String?  // free-form JSON string for extras (provider, oldRole, newRole, etc.)
  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ---- Enum ----------------------------------------------------------------

enum Role {
  ADMIN
  USER
}
